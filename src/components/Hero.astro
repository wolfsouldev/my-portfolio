---
const personalImageAlt = "Alejandro Fajardo";
import { AnimatedTooltip } from "./ui/animated-tooltip";
import { Button } from "./ui/button";
import { FlipWords } from "./ui/flip-words";
import { Contact, Linkedin } from "lucide-react";

const flipWordsArr = ["Backend", "Frontend"];

const people = [
  {
    id: 1,
    name: "Alejandro",
    designation: "Software Engineer",
    image: "/me.jpg",
  },
];
---

<div class="max-w-4xl mb-12">
  <div class="flex gap-4 mb-4 ">
    <AnimatedTooltip items={people} client:load />

    <a
      href="https://linkedin.com/in/midudev"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <!-- <Badge variant={"secondary"} className="p-2 border-green-500 shadow-lg"
        >Disponible para trabajar</Badge
      > -->
    </a>
  </div>
  <h1
    class="text-3xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    Hey, soy Alejandro
  </h1>
  <span class="mt-3 text-xl text-orange-500 font-bold">
    Desarollador
    <FlipWords
      words={flipWordsArr}
      client:load
      className="mt-3 text-xl  -ml-2 "
      duration={5000}
    />
  </span>
  <!-- <TypingAnimation text="Desarrollador Backend" client:load className="-ml-12"   /> -->
  <p
    class="mt-3 text-xl text-gray-800 dark:[&>strong]:text-orange-500 [&>strong]:text-orange-500 [&>strong]:font-semibold dark:text-gray-300"
  >
    <strong>Ingeniero de Software </strong> de Cuba. Especializado en el desarrollo
    de aplicaciones web únicas
  </p>
  <nav class="flex flex-wrap gap-4 mt-8"></nav>

  <aside>
    <Button className="rounded-3xl group"
      ><Contact
        className="mr-2 group-hover:-translate-y-1 transform duration-200 "
      />Contactame
    </Button>
    <Button className="rounded-3xl group group-hover:text-orange-500"
      ><Linkedin
        className="mr-2 group-hover:-translate-y-1 transform duration-200 "
      />Linkedin
    </Button>
  </aside>
</div>

<style is:inline></style>

---
const personalImageAlt = "Miguel Ángel";
import { Button } from "./ui/button";
import { FlipWords } from "./ui/flip-words";
import TypingAnimation from "./ui/typing-animation";
import { Contact, Linkedin } from "lucide-react";

const flipWordsArr = ["Backend", "Frontend"];
---

<div class="max-w-3xl">
  <div class="flex gap-4 mb-4 pt-16">
    <img
      class="rounded-full shadow-lg size-16"
      src="/me.jpg"
      alt={personalImageAlt}
    />
    <a
      href="https://linkedin.com/in/midudev"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <!-- <Badge variant={"secondary"} className="p-2 border-green-500 shadow-lg"
        >Disponible para trabajar</Badge
      > -->
    </a>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    Hey, soy Alejandro
  </h1>
  <span class="mt-3 text-xl text-orange-500 font-semibold">
    Desarollador
    <FlipWords
      words={flipWordsArr}
      client:load
      className="mt-3 text-lg text-orange-500 -ml-2 "
      duration={5000}
    />
  </span>
  <!-- <TypingAnimation text="Desarrollador Backend" client:load className="-ml-12"   /> -->
  <p
    class="mt-3 text-xl text-gray-800 dark:[&>strong]:text-orange-300 [&>strong]:text-orange-500 [&>strong]:font-semibold dark:text-gray-300"
  >
    <strong>Ingeniero de Software </strong> de Cuba. Especializado en el desarrollo
    de aplicaciones web únicas
  </p>
  <nav class="flex flex-wrap gap-4 mt-8"></nav>

  <aside>
    <Button className="rounded-3xl group"
      ><Contact className="mr-2 group-hover:animate-bounce" />Contactame
    </Button>
    <Button className="rounded-3xl group last:"
      ><Linkedin className="mr-2 group-hover:animate-bounce" />Linkedin
    </Button>
  </aside>
</div>

<style is:inline>

</style>

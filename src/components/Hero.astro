---
import { ArrowDownRight, ArrowUpRight, Download, Github, Linkedin, Mail, Orbit } from "lucide-react";
import HeroOrbit from "./HeroOrbit.astro";
---
<div class="hero-grid">
  <div class="hero-copy" data-reveal>
    <span class="cosmic-kicker"><Orbit size={14} aria-hidden="true" /> Portfolio / Alejandro Fajardo</span>
    <div class="hero-identity"><img src="/me_.jpg" alt="Alejandro Fajardo" width="56" height="56" /><span>Software Engineer<span>Backend · Full-stack</span></span></div>
    <h1>Hey, soy <span>Alejandro<span class="hero-period">.</span></span></h1>
    <p class="hero-lead">Ideas que despegan.<br />Software que se mantiene sólido.</p>
    <p class="hero-description">Ingeniero de software especializado en desarrollo backend, arquitecturas de microservicios y aplicaciones web. Conecto las piezas para convertir ideas en productos que pueden crecer.</p>
    <div class="hero-actions"><a class="cosmic-button cosmic-button--primary" href="#proyectos">Explorar proyectos <ArrowDownRight aria-hidden="true" /></a><a class="cosmic-button" href="mailto:alejandrodev01@gmail.com"><Mail aria-hidden="true" /> Hablemos</a></div>
    <div class="hero-socials"><a href="https://github.com/wolfsouldev" target="_blank" rel="noopener noreferrer"><Github size={15} aria-hidden="true" /> GitHub <ArrowUpRight size={12} aria-hidden="true" /></a><a href="https://www.linkedin.com/in/alejandro-fajardo-1548a0245/" target="_blank" rel="noopener noreferrer"><Linkedin size={15} aria-hidden="true" /> LinkedIn <ArrowUpRight size={12} aria-hidden="true" /></a><a href="/docs/alejandro-fajardo-cv.pdf" download="Alejandro-Fajardo-CV.pdf"><Download size={15} aria-hidden="true" /> Descargar CV</a></div>
  </div>
  <div class="hero-visual" data-reveal><HeroOrbit /></div>
</div>
<div class="hero-baseline"><span><i></i> Backend first. Siempre explorando.</span><a href="#experiencia">Comenzar el recorrido <ArrowDownRight size={13} aria-hidden="true" /></a></div>
<style>
  .hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; align-items: center; gap: clamp(2rem, 5vw, 5rem); }
  .hero-copy { min-width: 0; }
  .hero-identity { display: flex; align-items: center; gap: .8rem; margin-top: 2rem; }
  .hero-identity img { width: 48px; height: 48px; padding: 3px; border: 1px solid rgb(249 115 22 / .4); border-radius: 50%; object-fit: cover; }
  .hero-identity > span { color: var(--cosmic-text); font-size: .78rem; font-weight: 600; }
  .hero-identity > span > span { display: block; margin-top: .3rem; color: var(--cosmic-soft); font: .62rem/1.3 ui-monospace, monospace; }
  h1 { margin-top: 1.4rem; font-size: clamp(2.8rem, 5.6vw, 4.9rem); line-height: 1.05; font-weight: 700; letter-spacing: -.065em; }
  h1 > span { display: block; }
  .hero-period { color: var(--cosmic-accent); }
  .hero-lead { margin-top: 1.5rem; color: var(--cosmic-text); font-size: clamp(1.15rem, 2.3vw, 1.6rem); font-weight: 500; line-height: 1.45; letter-spacing: -.025em; }
  .hero-description { max-width: 32rem; margin-top: 1rem; color: var(--cosmic-muted); font-size: .94rem; line-height: 1.85; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 1.75rem; }
  .hero-socials { display: flex; align-items: center; flex-wrap: wrap; gap: .85rem 1.5rem; margin-top: 1.5rem; }
  .hero-socials a { display: inline-flex; align-items: center; gap: .45rem; color: var(--cosmic-soft); font-size: .73rem; transition: color .2s; }
  .hero-socials a:hover { color: var(--cosmic-accent); }
  .hero-visual { min-width: 0; }
  .hero-baseline { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-top: 3.5rem; padding-top: 1.25rem; border-top: 1px solid var(--cosmic-border); color: var(--cosmic-soft); font: .62rem/1.5 ui-monospace, monospace; }
  .hero-baseline > span, .hero-baseline > a { display: inline-flex; align-items: center; gap: .5rem; }
  .hero-baseline i { width: 4px; height: 4px; background: var(--cosmic-violet); border-radius: 50%; }
  .hero-baseline > a:hover { color: var(--cosmic-accent); }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1.1fr .9fr; gap: 1rem; } .hero-copy > .cosmic-kicker { font-size: .58rem; } }
  @media (max-width: 700px) { .hero-grid { grid-template-columns: 1fr; gap: 2.75rem; } .hero-identity { margin-top: 1.5rem; } .hero-visual { padding: 0 .5rem; } .hero-baseline { margin-top: 2rem; font-size: .58rem; } }
  @media (prefers-reduced-motion: reduce) { .hero-socials a { transition: none; } }
</style>

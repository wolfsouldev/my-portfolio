---
import { Sparkles } from "lucide-react";
import { OrbitingCirclesDemo } from "./Orbital";
import Animation from "./Animation.astro";
---
<figure class="hero-orbit" aria-label="Astronauta escribiendo rodeado de planetas y tecnologías en órbita">
  <div class="orbit-coordinates" aria-hidden="true"><span>SYS / AF.01</span><Sparkles size={13} /></div>
  <div class="orbit-scene" data-orbit-scene>
    <div class="orbit-inner"><OrbitingCirclesDemo><Animation /></OrbitingCirclesDemo></div>
  </div>
  <figcaption><span></span>Ideas conectadas. Sistemas en órbita.</figcaption>
</figure>
<script>
  document.querySelectorAll<HTMLElement>("[data-orbit-scene]").forEach((scene) => {
    const resize = (width: number) => scene.style.setProperty("--scene-scale", String(Math.min(1, width / 560)));
    resize(scene.getBoundingClientRect().width);
    const observer = new ResizeObserver(([entry]) => resize(entry.contentRect.width));
    observer.observe(scene);
  });
</script>
<style>
  .hero-orbit { width: 100%; min-width: 0; max-width: 560px; margin-inline: auto; }
  .orbit-coordinates { display: flex; justify-content: space-between; padding-inline: 1.5rem; color: var(--cosmic-soft); font: .58rem/1 ui-monospace, monospace; letter-spacing: .13em; }
  .orbit-coordinates :global(svg) { color: var(--cosmic-accent); }
  .orbit-scene { position: relative; width: 100%; aspect-ratio: 1; overflow: hidden; isolation: isolate; }
  .orbit-scene::before { content: ""; position: absolute; z-index: -1; inset: 10%; border-radius: 50%; background: radial-gradient(circle, rgb(139 92 246 / .08), transparent 70%); }
  .orbit-inner { position: absolute; left: 50%; top: 50%; width: 560px; height: 560px; transform: translate(-50%, -50%) scale(var(--scene-scale, .6)); }
  .orbit-inner :global(.orbital-system > svg circle) { stroke: var(--cosmic-border); }
  .orbit-inner :global(.animate-orbit > svg) { max-width: 100%; max-height: 100%; }
  figcaption { display: flex; align-items: center; justify-content: center; gap: .5rem; color: var(--cosmic-soft); font: 500 .59rem/1.5 ui-monospace, monospace; }
  figcaption > span { width: 4px; height: 4px; border-radius: 50%; background: var(--cosmic-accent); box-shadow: 0 0 12px rgb(249 115 22 / .5); }
  @media (max-width: 700px) { .hero-orbit { max-width: 370px; } }
  @media (prefers-reduced-motion: reduce) { .orbit-inner :global(.animate-orbit) { animation-play-state: paused; } }
</style>

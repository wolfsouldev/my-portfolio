---
import { Orbit, Braces, CloudCog, ServerCog } from "lucide-react";

import SectionHeading from "./SectionHeading.astro";

const skillGroups = [
  {
    id: "backend",
    index: "01",
    title: "Backend & datos",
    description: "Sistemas robustos, APIs y arquitecturas preparadas para crecer.",
    skills: [
      "Node.js", "NestJS", "Express", "Python", "Django", "FastAPI",
      "PostgreSQL", "MongoDB", "Redis", "GraphQL", "WebSockets", "Kafka",
      "RabbitMQ", "Supabase",
    ],
  },
  {
    id: "frontend",
    index: "02",
    title: "Frontend & producto",
    description: "Interfaces rápidas y mantenibles, de la web al móvil.",
    skills: [
      "TypeScript", "React", "Next.js", "Astro", "Angular", "React Native",
      "Expo", "Tailwind CSS", "Material UI", "Framer Motion",
    ],
  },
  {
    id: "platform",
    index: "03",
    title: "Cloud & workflow",
    description: "Entornos reproducibles y entregas automatizadas.",
    skills: ["Docker", "AWS", "Kubernetes", "CI/CD", "GitHub", "Jest", "Prisma", "TypeORM"],
  },
];
---

<div class="skills-shell">
  <SectionHeading index="02" kicker="Sistemas en órbita" title="Tecnologías" description="Herramientas que utilizo para llevar un producto desde la idea hasta producción.">
    <Orbit slot="icon" aria-hidden="true" />
  </SectionHeading>
  <div class="skill-grid">
    {skillGroups.map((group) => (
      <article class="skill-panel cosmic-panel" data-reveal>
        <div class="skill-orbit" aria-hidden="true"><i></i></div>
        <div class="skill-panel__head">
          <span class="skill-index">SYS / {group.index}</span>
          <span class="skill-icon" aria-hidden="true">
            {group.id === "backend" && <ServerCog />}
            {group.id === "frontend" && <Braces />}
            {group.id === "platform" && <CloudCog />}
          </span>
        </div>
        <h3>{group.title}</h3>
        <p>{group.description}</p>
        <ul aria-label={`Tecnologías de ${group.title}`}>
          {group.skills.map((skill) => <li class="cosmic-chip">{skill}</li>)}
        </ul>
      </article>
    ))}
  </div>
</div>
<style>
  .skill-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .skill-panel { padding: var(--panel-padding); min-width: 0; transition: transform .35s ease, border-color .35s ease, box-shadow .35s ease; }
  .skill-panel:hover { transform: translateY(-4px); }
  .skill-panel__head { display: flex; align-items: center; justify-content: space-between; }
  .skill-index { color: var(--cosmic-soft); font: .65rem/1 ui-monospace, monospace; letter-spacing: .1em; }
  .skill-icon { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 1px solid var(--cosmic-border); border-radius: .85rem; background: var(--cosmic-chip); color: var(--cosmic-violet); }
  .skill-panel:first-child .skill-icon { color: var(--cosmic-accent); border-color: rgb(249 115 22 / .2); background: rgb(249 115 22 / .05); }
  .skill-icon :global(svg) { width: 1.25rem; height: 1.25rem; transition: transform .4s ease; }
  .skill-panel:hover .skill-icon :global(svg) { transform: rotate(-8deg); }
  h3 { margin-top: 2rem; font-size: 1.25rem; font-weight: 650; letter-spacing: -.025em; }
  .skill-panel > p { min-height: 3.5rem; margin-top: .7rem; color: var(--cosmic-muted); font-size: .9rem; line-height: 1.75; }
  .skill-panel ul { position: relative; display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1.25rem; }
  .skill-panel li { transition: border-color .2s, color .2s; }
  .skill-panel li:hover { color: var(--cosmic-accent); border-color: rgb(249 115 22 / .4); }
  .skill-orbit { position: absolute; z-index: -1; right: -50px; bottom: -60px; width: 180px; height: 180px; border: 1px solid var(--cosmic-border); border-radius: 50%; opacity: .5; transition: transform .5s ease; }
  .skill-orbit::before { content: ""; position: absolute; inset: 24px; border: 1px dashed var(--cosmic-border); border-radius: 50%; }
  .skill-orbit i { position: absolute; top: 24px; left: 24px; width: 5px; height: 5px; border-radius: 50%; background: var(--cosmic-violet); box-shadow: 0 0 12px rgb(139 92 246 / .25); }
  .skill-panel:hover .skill-orbit { transform: rotate(18deg); }
  @media (max-width: 950px) { .skill-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .skill-panel:first-child { grid-column: 1 / -1; } .skill-panel:first-child > p { min-height: auto; } }
  @media (max-width: 600px) { .skill-grid { grid-template-columns: minmax(0, 1fr); } .skill-panel { padding: 1.5rem; } .skill-panel:first-child { grid-column: auto; } .skill-panel > p { min-height: auto; } }
  @media (prefers-reduced-motion: reduce) { .skill-panel, .skill-panel li, .skill-orbit, .skill-icon :global(svg) { transition: none; } .skill-panel:hover, .skill-panel:hover .skill-orbit, .skill-panel:hover .skill-icon :global(svg) { transform: none; } }
</style>

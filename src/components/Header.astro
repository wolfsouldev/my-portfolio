---
import { Menu, Moon, Orbit, Sun, X } from "lucide-react";
const navItems = [
  { title: "Experiencia", id: "experiencia" },
  { title: "Tecnologías", id: "skills" },
  { title: "Sobre mí", id: "sobre-mi" },
  { title: "Proyectos", id: "proyectos" },
  { title: "Contacto", id: "contacto" },
];
---
<header class="site-header site-container">
  <div class="nav-shell">
    <a class="nav-brand" href="#inicio" aria-label="Alejandro Fajardo, volver al inicio"><Orbit size={20} aria-hidden="true" /><span>AF<span class="brand-suffix"> / dev</span></span></a>
    <nav id="main-navigation" aria-label="Navegación principal">
      {navItems.map((item, index) => <a href={`#${item.id}`} data-nav={item.id}><span class="nav-number" aria-hidden="true">0{index + 1}</span>{item.title}</a>)}
    </nav>
    <div class="nav-controls">
      <button type="button" class="theme-toggle" aria-label="Cambiar a tema claro" title="Cambiar tema"><Sun className="sun-icon" size={17} aria-hidden="true" /><Moon className="moon-icon" size={17} aria-hidden="true" /></button>
      <button type="button" class="menu-toggle" aria-label="Abrir navegación" aria-expanded="false" aria-controls="main-navigation"><Menu className="menu-icon" size={19} aria-hidden="true" /><X className="close-icon" size={19} aria-hidden="true" /></button>
    </div>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>(".site-header")!;
  const menu = header.querySelector<HTMLButtonElement>(".menu-toggle")!;
  const themeButton = header.querySelector<HTMLButtonElement>(".theme-toggle")!;
  const links = [...header.querySelectorAll<HTMLAnchorElement>("[data-nav]")];
  header.dataset.menuReady = "true";
  const closeMenu = () => {
    header.dataset.menuOpen = "false";
    menu.setAttribute("aria-expanded", "false");
    menu.setAttribute("aria-label", "Abrir navegación");
  };
  menu.addEventListener("click", () => {
    const open = menu.getAttribute("aria-expanded") !== "true";
    header.dataset.menuOpen = String(open);
    menu.setAttribute("aria-expanded", String(open));
    menu.setAttribute("aria-label", open ? "Cerrar navegación" : "Abrir navegación");
  });
  links.forEach((link) => link.addEventListener("click", closeMenu));
  document.addEventListener("click", (event) => { if (!header.contains(event.target as Node)) closeMenu(); });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu.getAttribute("aria-expanded") === "true") { closeMenu(); menu.focus(); }
  });
  const updateThemeLabel = () => {
    const dark = document.documentElement.classList.contains("dark");
    themeButton.setAttribute("aria-label", `Cambiar a tema ${dark ? "claro" : "oscuro"}`);
  };
  themeButton.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch { /* Theme still works when storage is unavailable. */ }
    updateThemeLabel();
  });
  updateThemeLabel();
  const sections = [...document.querySelectorAll<HTMLElement>("main > [data-section]")];
  const updateActive = () => {
    let current = "inicio";
    for (const section of sections) if (section.getBoundingClientRect().top <= 180) current = section.id;
    if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 8) {
      current = sections.at(-1)?.id ?? current;
    }
    links.forEach((link) => {
      if (link.dataset.nav === current) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
  };
  let queued = false;
  window.addEventListener("scroll", () => {
    if (!queued) { queued = true; requestAnimationFrame(() => { updateActive(); queued = false; }); }
  }, { passive: true });
  window.addEventListener("resize", () => { closeMenu(); updateActive(); });
  updateActive();
</script>
<style>
  .site-header { position: fixed; inset-inline: 0; top: 1.25rem; z-index: 50; }
  .nav-shell { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 4rem; padding: .55rem .8rem .55rem 1.1rem; border: 1px solid var(--cosmic-border); border-radius: 1.1rem; background: rgb(248 249 254 / .85); backdrop-filter: blur(20px); box-shadow: 0 10px 35px -20px rgb(0 0 0 / .25); }
  :global(.dark) .nav-shell { background: rgb(9 13 27 / .86); }
  .nav-brand { display: inline-flex; align-items: center; gap: .55rem; flex-shrink: 0; font: 600 .82rem/1 ui-monospace, monospace; letter-spacing: -.03em; }
  .nav-brand :global(svg) { color: var(--cosmic-accent); }
  .brand-suffix { color: var(--cosmic-soft); font-weight: 400; }
  nav { display: flex; align-items: center; gap: .15rem; }
  nav a { display: inline-flex; align-items: center; gap: .5rem; border-radius: .65rem; padding: .65rem .8rem; color: var(--cosmic-muted); font-size: .79rem; transition: color .2s, background .2s; }
  nav a:hover, nav a[aria-current] { color: var(--cosmic-accent); background: rgb(249 115 22 / .07); }
  .nav-number { display: none; }
  .nav-controls { display: flex; align-items: center; gap: .3rem; }
  .theme-toggle, .menu-toggle { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; flex-shrink: 0; border: 1px solid var(--cosmic-border); border-radius: .7rem; color: var(--cosmic-muted); background: var(--cosmic-chip); transition: color .2s, border-color .2s; }
  .theme-toggle:hover, .menu-toggle:hover { color: var(--cosmic-accent); border-color: var(--cosmic-accent); }
  .theme-toggle { display: none; }
  [data-menu-ready] .theme-toggle { display: grid; }
  .theme-toggle :global(.sun-icon) { display: none; }
  :global(.dark) .theme-toggle :global(.sun-icon) { display: block; }
  :global(.dark) .theme-toggle :global(.moon-icon) { display: none; }
  .menu-toggle { display: none; }
  .menu-toggle :global(.close-icon) { display: none; }
  @media (max-width: 850px) {
    .nav-shell { gap: .75rem; }
    nav a { padding-inline: .55rem; font-size: .73rem; }
    .brand-suffix { display: none; }
  }
  @media (max-width: 640px) {
    .site-header { top: .75rem; }
    .nav-shell { min-height: 3.75rem; flex-wrap: wrap; padding: .55rem .65rem .55rem .9rem; }
    .nav-controls { margin-left: auto; }
    nav { flex-basis: 100%; flex-wrap: wrap; order: 3; }
    nav a { font-size: .8rem; }
    [data-menu-ready] nav { display: none; position: absolute; inset-inline: 0; top: calc(100% + .6rem); padding: .65rem; border: 1px solid var(--cosmic-border); border-radius: 1rem; background: var(--cosmic-bg); box-shadow: 0 12px 32px rgb(0 0 0 / .15); }
    [data-menu-ready][data-menu-open="true"] nav { display: grid; grid-template-columns: 1fr 1fr; gap: .25rem; }
    [data-menu-ready] nav a { padding: .85rem .7rem; }
    .nav-number { display: inline; color: var(--cosmic-soft); font: .6rem ui-monospace, monospace; }
    [data-menu-ready] .menu-toggle { display: grid; }
    [data-menu-open="true"] .menu-toggle :global(.menu-icon) { display: none; }
    [data-menu-open="true"] .menu-toggle :global(.close-icon) { display: block; }
  }
  @media (prefers-reduced-motion: reduce) { nav a, .theme-toggle, .menu-toggle { transition: none; } }
</style>

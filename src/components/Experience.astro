---
import { Briefcase } from "lucide-react";
import ExperienceItem from "./ExperienceItem.astro";
const EXPERIENCE = [
  {
    date: "Noviembre 2024 — Actualidad",
    title: "Principal Software Engineer",
    company: "Cute Digital Media",
    description:
      "Mantenimiento y evolución de productos basados en microservicios y sistemas multitenant. Reestructuración de plataformas para mejorar escalabilidad, seguridad y eficiencia, incorporando mejores prácticas de desarrollo.",
  },
  {
    date: "Septiembre 2023 — 2024",
    title: "Full-Stack Engineer",
    company: "Tecopos",
    description:
      "Lideré la migración de una arquitectura monolítica a microservicios. Desarrollé y optimicé funcionalidades de frontend y backend, además de implementar CI/CD y estrategias de despliegue automatizado.",
  },
  {
    date: "Octubre 2021 — 2022",
    title: "Principal Backend Engineer",
    company: "UNE Mtz",
    description:
      "Diseño, desarrollo y mantenimiento del sistema principal de la empresa. Automaticé procesos clave, implementé integración continua y A/B testing, y lideré dos equipos de desarrollo.",
  },
];
---

<div class="experience-shell">
  <header class="experience-heading">
    <div>
      <span>Trayectoria</span>
      <h2><Briefcase className="size-8" /> Experiencia</h2>
    </div>
    <p>Construyendo y modernizando productos digitales desde 2021.</p>
  </header>

  <ol class="experience-list">
    {EXPERIENCE.map((experience, index) => (
      <li>
        <ExperienceItem {...experience} index={index + 1} current={index === 0} />
      </li>
    ))}
  </ol>
</div>

<style>
  .experience-shell { padding: 1rem 0; }
  .experience-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
  .experience-heading span { color: rgb(251 146 60); font: 600 .72rem/1 ui-monospace, monospace; letter-spacing: .16em; text-transform: uppercase; }
  .experience-heading h2 { display: flex; align-items: center; gap: .75rem; margin-top: .45rem; font-size: clamp(2rem, 4vw, 3.25rem); font-weight: 700; letter-spacing: -.045em; }
  .experience-heading > p { max-width: 27rem; color: rgb(107 114 128); line-height: 1.7; }
  :global(.dark) .experience-heading > p { color: rgb(156 163 175); }
  .experience-list { overflow: hidden; border: 1px solid rgb(0 0 0 / .09); border-radius: 1.75rem; background: rgb(255 255 255 / .55); }
  :global(.dark) .experience-list { border-color: rgb(255 255 255 / .1); background: rgb(10 15 28 / .64); }
  .experience-list > li + li { border-top: 1px solid rgb(0 0 0 / .09); }
  :global(.dark) .experience-list > li + li { border-color: rgb(255 255 255 / .1); }
  @media (max-width: 640px) { .experience-heading { align-items: start; flex-direction: column; gap: .75rem; } }
</style>

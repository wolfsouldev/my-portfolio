---
import { motion } from "framer-motion";

interface Props {
  class?: string;
  id: string;
  animated?: boolean;
}

const { class: className, id, animated = true } = Astro.props;
---

{
  animated && (
    <motion.section
      id={id}
      data-section={id}
      className={`section ${className} w-full mx-auto container lg:max-w-5xl md:max-w-3xl`}
      initial={{ opacity: 0, y: 20, scale: 0.9, rotate: -2 }}
      whileInView={{ opacity: 1, y: 0, scale: 1, rotate: 0 }}
      transition={{
        type: "spring",
        stiffness: 70,
        damping: 15,
        delay: 0.2,
      }}
      viewport={{ once: true }}
      client:visible
    >
      <slot />
    </motion.section>
  )
}

{
  !animated && (
    <section
      class={`section ${className} w-full mx-auto container lg:max-w-5xl md:max-w-3xl`}
    >
      <slot />
    </section>
  )
}

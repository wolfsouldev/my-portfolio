---
import Layout from "../layouts/Layout.astro";
import "@/global.css";
import Header from "@/components/Header.astro";
import SectionContainer from "@/container/SectionContainer.astro";
import Hero from "@/components/Hero.astro";
import Animation from "@/components/Animation.astro";
import { OrbitingCirclesDemo } from "@/components/Orbital";
import Experience from "@/components/Experience.astro";
import AboutMe from "@/components/AboutMe.astro";
import Skills from "@/components/Skills.astro";
import Star from "@/container/Satrs.astro";
import { TextParallaxContentExample } from "@/components/Proyects";
---

<Layout title="Alejandro Porfolio">
  <Header />
  <main
    class="flex flex-col gap-y-10 w-full h-full my-auto py-32 overflow-x-hidden"
  >
    <Star  />
    <SectionContainer
      class="flex gap-x-15 justify-center items-center mb-12 sm:mb-5"
      id=""
      animated={false}
    >
      <Hero />
      <OrbitingCirclesDemo>
        <Animation />
      </OrbitingCirclesDemo>
    </SectionContainer>

    <SectionContainer id="experiencia">
      <Experience />
    </SectionContainer>

    <SectionContainer id="skills">
      <Skills />
    </SectionContainer>

    <SectionContainer id="sobre-mi">
      <AboutMe />
    </SectionContainer>

    <SectionContainer id="proyectos">
      <TextParallaxContentExample client:load />
    </SectionContainer>
  </main>
</Layout>

<script is:inline>
  const getThemePreference = () => {
    localStorage.setItem("theme", "dark");
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  };
  const isDark = getThemePreference() === "dark";
  document.documentElement.classList[isDark ? "add" : "remove"]("dark");

  if (typeof localStorage !== "undefined") {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }
</script>

<style is:global>
  ::-webkit-scrollbar {
    display: none;
  }


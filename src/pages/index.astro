---
import Layout from "../layouts/Layout.astro";
import "@/global.css";
import Header from "@/components/Header.astro";
import SectionContainer from "@/container/SectionContainer.astro";
import Hero from "@/components/Hero.astro";
import Experience from "@/components/Experience.astro";
import AboutMe from "@/components/AboutMe.astro";
import Skills from "@/components/Skills.astro";
import Contact from "@/components/Contact.astro";
import { TextParallaxContentExample } from "@/components/Proyects";
---
<Layout title="Alejandro Fajardo · Software Engineer">
  <Header />
  <main id="contenido" class="portfolio-main" tabindex="-1">
    <SectionContainer id="inicio"><Hero /></SectionContainer>
    <SectionContainer id="experiencia"><Experience /></SectionContainer>
    <SectionContainer id="skills"><Skills /></SectionContainer>
    <SectionContainer id="sobre-mi"><AboutMe /></SectionContainer>
    <SectionContainer id="proyectos"><TextParallaxContentExample client:load /></SectionContainer>
    <SectionContainer id="contacto"><Contact /></SectionContainer>
  </main>
</Layout>
